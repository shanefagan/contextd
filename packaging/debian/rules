#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	unset CFLAGS CXXFLAGS LDFLAGS RUSTFLAGS && cargo build --release --workspace --locked

override_dh_auto_test:
	cargo test --release --workspace --locked

override_dh_auto_install:
	./scripts/package-portable.sh build/tree target/release
	mkdir -p debian/contextd/opt
	cp -a build/tree/contextd debian/contextd/opt/contextd
	cp -a build/tree/host/usr debian/contextd/usr
