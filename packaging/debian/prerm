#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        systemctl disable --now openrgb-contextd-bridge.service 2>/dev/null || true
        echo ">>> Detaching contextd portable service..."
        portablectl detach --now --enable contextd || true
    ;;

    upgrade)
        # postinst of the new version reattaches.
        portablectl detach --now contextd || true
    ;;

    failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
