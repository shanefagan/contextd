# Maintainer: Shane Fagan <shane@performativenonsense.com>
pkgname=contextd-git
pkgver=0.10.0.r0.0000000
pkgrel=1
pkgdesc="Lightweight game and hardware context daemon (Portable Hybrid)"
arch=('x86_64')
url="https://github.com/shanefagan/contextd"

license=('MIT')
depends=('systemd')
makedepends=('git' 'cargo')
provides=('contextd')
conflicts=('contextd')
source=("contextd::git+https://github.com/shanefagan/contextd")

md5sums=('SKIP')

pkgver() {
  cd "$srcdir/contextd"
  local version
  version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
  printf "%s.r%s.%s" "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/contextd"
  # Clear all environment flags that might interfere with bundled C compilation
  unset CFLAGS CXXFLAGS LDFLAGS RUSTFLAGS
  export LIBSQLITE3_SYS_BUNDLED=1
  cargo build --release --workspace --locked
}

check() {
  cd "$srcdir/contextd"
  cargo test --release --workspace --locked
}

package() {
  cd "$srcdir/contextd"

  # 1. Portable service image in /opt
  ./scripts/package-portable.sh "$srcdir/tree" target/release
  install -d "$pkgdir/opt"
  cp -a "$srcdir/tree/contextd" "$pkgdir/opt/contextd"

  # 2. Host side: rgb group, OpenRGB bridge (optional service), CLI
  cp -a "$srcdir/tree/host/usr" "$pkgdir/usr"
}

# Post-install logic attaches the portable service
install=contextd.install
