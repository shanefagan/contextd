post_install() {
  # The pacman sysusers hook runs after this scriptlet, but the control
  # socket needs its group before it starts.
  systemd-sysusers contextd.conf
  echo ">>> Attaching contextd portable service from /opt..."
  portablectl attach --now --enable --copy=symlink --profile=trusted /opt/contextd
  systemctl --global enable contextd-focus.service
  echo ">>> Add users who may change lighting to the contextd-rgb group."
  echo ">>> Optional OpenRGB bridge: systemctl enable --now openrgb-contextd-bridge.service"
}

pre_remove() {
  echo ">>> Detaching contextd portable service..."
  systemctl disable --now openrgb-contextd-bridge.service 2>/dev/null || true
  systemctl --global disable contextd-focus.service 2>/dev/null || true
  portablectl detach --now --enable contextd || true
}

post_upgrade() {
  systemd-sysusers contextd.conf
  echo ">>> Reattaching contextd portable service from /opt..."
  portablectl detach --now --enable contextd || true
  portablectl attach --now --enable --copy=symlink --profile=trusted /opt/contextd
}
