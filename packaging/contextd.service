[Unit]
Description=Context Daemon
Documentation=https://github.com/shanefagan/contextd
Requires=contextd.socket
After=contextd.socket

[Service]
ExecStart=/usr/bin/contextd
Sockets=contextd.socket
DynamicUser=yes
# Host paths the daemon reads. In the portable image these are the only
# host files it can see at all; "-" marks paths that may not exist.
BindReadOnlyPaths=/usr/lib -/usr/lib64 -/lib -/lib64 /etc/ld.so.cache -/etc/contextd -/etc/passwd -/etc/udev/rules.d /home /run/udev /sys -/usr/share/hwdata -/usr/share/vulkan -/etc/vulkan -/usr/share/glvnd
# CAP_SYS_PTRACE reads /proc/*/environ to spot game processes;
# CAP_DAC_READ_SEARCH reads launcher manifests in users' homes.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
# Defence in depth for non-portable installs, where the host root is
# visible and CAP_DAC_READ_SEARCH would otherwise reach these.
InaccessiblePaths=-/etc/shadow -/etc/gshadow -/etc/shadow- -/etc/gshadow- -/etc/ssh -/root -/var/lib -/etc/NetworkManager/system-connections

# Accounting (CPU accounting is always on with cgroup v2; systemd 258 removed the option)
MemoryAccounting=yes
IOAccounting=yes
TasksAccounting=yes
IPAccounting=yes

# Sandboxing & Security
ProtectSystem=strict
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=no
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
Also=contextd.socket
