interface com.performativenonsense.contextd.rgb.Observer

# RGBA Color representation
type Color (
  r: int,
  g: int,
  b: int,
  a: int
)

# A rectangular matrix of colors (width x height)
type Matrix (
  width: int,
  height: int,
  data: []Color
)

# The same matrix in compact form: width * height pixels, row-major, four
# bytes each (R, G, B, A), base64-encoded (standard alphabet, padded).
# About an eighth of the size of Matrix in JSON.
type PackedMatrix (
  width: int,
  height: int,
  rgba: string
)

# Returns the current ambient lighting context. With `packed` set to true
# the matrix is returned in `packed_matrix` instead of `matrix`.
method GetLightingContext(packed: ?bool) -> (
  main_color: Color,
  matrix: ?Matrix,
  packed_matrix: ?PackedMatrix
)

# Subscribes to lighting context updates (call with "more": true). With
# `packed` set to true the matrix is sent in `packed_matrix`.
method SubscribeLightingContext(packed: ?bool) -> (
  main_color: Color,
  matrix: ?Matrix,
  packed_matrix: ?PackedMatrix
)
