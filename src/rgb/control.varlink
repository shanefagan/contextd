interface com.performativenonsense.contextd.rgb.Control

# RGBA Color representation
type Color (
  r: int,
  g: int,
  b: int,
  a: int
)

# A rectangular matrix of colors (width x height)
type Matrix (
  width: int,
  height: int,
  data: []Color
)

# Sets the current lighting context.
method SetLightingContext(
  main_color: ?Color,
  matrix: ?Matrix
) -> ()

# The Matrix size requested is too large
error MatrixTooLarge(max_pixels: int)

# The Matrix data length does not match width * height
error InvalidMatrixSize(width: int, height: int, data_len: int)

# A color component value is outside the valid range (0-255)
error InvalidColorValue(component: string, value: int)
error PermissionDenied(unit: string)
