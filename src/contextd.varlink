interface com.performativenonsense.contextd


# Hardware device type
type Device (
  name: string,
  vendor: string,
  vendor_id: string,
  product_id: string,
  bus_type: string,
  path: string,
  classes: []string,
  has_uaccess: bool,
  controllers: []Controller
)

# Hint about an application that can control hardware
type Controller (
  name: string,
  version: ?string,
  pid: int,
  description: ?string,
  website: ?string,
  capabilities: []string,
  interested_devices: []string
)

# Game information
type Game (
  name: string,
  id: ?string,
  source: string,
  pid: ?int
)

# GPU Information
type Gpu (
  name: string,
  vendor: string,
  driver: string,
  vram_total: int
)

# System Diagnostics
type Diagnostics (
  vulkan_supported: bool,
  vulkan_version: ?string,
  opengl_supported: bool,
  ram_total: int,
  cpu_model: string,
  cpu_count: int,
  gpus: []Gpu,
  kernel_version: string,
  last_updated: int # Unix timestamp
)

# Returns the currently active game, if any.
method GetActiveGame() -> (game: ?Game)

# Lists all installed games detected on the system.
method ListInstalledGames() -> (games: []Game)

# Lists all connected keyboards, mice, and controllers.
method ListDevices() -> (devices: []Device)

# Lists all RGB controllers, lighting strips, and fans.
method ListRGBDevices() -> (devices: []Device)

# Returns diagnostic information for the system.
method GetDiagnostics() -> (diagnostics: Diagnostics)

# Registers or updates a controller hint.
method RegisterController(controller: Controller) -> ()

# Unregisters a controller hint.
method UnregisterController(pid: int) -> ()

# Lists all active controller hints.
method ListControllers() -> (controllers: []Controller)

